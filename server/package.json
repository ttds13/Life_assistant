{
  "name": "life-assistant-server",
  "version": "0.1.0",
  "private": true,
  "description": "Life Assistant NestJS backend",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "db:verify": "tsx scripts/db-verify.ts",
    "day48:address-audit": "tsx --env-file=.env scripts/day48-order-address-audit.ts",
    "day48:address-smoke": "tsx --env-file=.env scripts/day48-order-address-smoke.ts",
    "day49:order-card-audit": "tsx --env-file=.env scripts/day49-order-member-card-audit.ts",
    "day49:order-card-smoke": "tsx --env-file=.env scripts/day46-member-card-time-balance-smoke.ts",
    "day50:user-commerce-audit": "tsx --env-file=.env scripts/day50-user-commerce-audit.ts",
    "day53:member-card-products-audit": "tsx --env-file=.env scripts/day53-member-card-products-audit.ts",
    "day54:appointment-lock-smoke": "tsx --env-file=.env scripts/day54-appointment-time-lock-smoke.ts",
    "day55:points-referral-smoke": "tsx --env-file=.env scripts/day55-points-referral-smoke.ts",
    "day56:admin-user-commerce-crud-smoke": "tsx --env-file=.env scripts/day56-admin-user-commerce-crud-smoke.ts",
    "day57:points-refund-test": "tsx scripts/day57-points-refund-calculation-test.ts",
    "day57:rbac-smoke": "tsx --env-file=.env scripts/day57-rbac-smoke.ts",
    "release:preflight": "node scripts/release-preflight.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:db": "tsx scripts/seed-db.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "images:backfill": "tsx scripts/backfill-image-files.ts",
    "oss:smoke": "tsx scripts/oss-smoke-test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/client": "^6.19.3",
    "ali-oss": "^6.23.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.0",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
