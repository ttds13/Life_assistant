generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 1. Users and Auth ====================

model User {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @default(uuid()) @db.VarChar(36)
  openid      String?   @unique @db.VarChar(64)
  unionid     String?   @db.VarChar(64)
  phone       String?   @db.VarChar(20)
  nickname    String?   @db.VarChar(64)
  avatarUrl   String?   @map("avatar_url") @db.VarChar(512)
  gender      Int       @default(0) @db.SmallInt
  status      Int       @default(1) @db.SmallInt
  cityCode    String?   @map("city_code") @db.VarChar(20)
  storeId     BigInt?   @map("store_id")
  source      String?   @default("miniapp") @db.VarChar(16)
  adminRemark String?   @map("admin_remark") @db.VarChar(512)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  orders          Order[]
  reviews         Review[]
  tickets         Ticket[]
  userCoupons     UserCoupon[]
  userMemberCards UserMemberCard[]
  favorites       ServiceFavorite[]
  staffProfile    Staff?
  refreshTokens   UserRefreshToken[]
  feedbacks       Feedback[]
  pointLedgers    PointLedger[]
  pointLedgerSources PointLedger[] @relation("PointLedgerSourceUser")
  pointRewardEvents PointRewardEvent[] @relation("PointRewardBeneficiary")
  pointRewardSourceEvents PointRewardEvent[] @relation("PointRewardSource")
  referralInviteCode ReferralInviteCode?
  referralInvites ReferralInvite[] @relation("ReferralInviteInviter")
  referralBindingsAsInviter ReferralBinding[] @relation("ReferralBindingInviter")
  referralBindingAsInvitee ReferralBinding? @relation("ReferralBindingInvitee")

  @@index([phone])
  @@index([cityCode])
  @@map("users")
}

model UserRefreshToken {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  source       String?   @default("miniapp") @db.VarChar(32)
  deviceId     String?   @map("device_id") @db.VarChar(128)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  ip           String?   @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById BigInt?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("user_refresh_tokens")
}

model Staff {
  id                BigInt    @id @default(autoincrement())
  uuid              String    @unique @default(uuid()) @db.VarChar(36)
  userId            BigInt?   @unique @map("user_id")
  name              String    @db.VarChar(64)
  phone             String    @db.VarChar(20)
  passwordHash      String    @map("password_hash") @db.VarChar(128)
  avatarUrl         String?   @map("avatar_url") @db.VarChar(512)
  idCard            String?   @map("id_card") @db.VarChar(20)
  skills            Json?
  status            Int       @default(1) @db.SmallInt
  workStatus        Int       @default(0) @map("work_status") @db.SmallInt
  cityCode          String?   @map("city_code") @db.VarChar(20)
  storeId           BigInt?   @map("store_id")
  applicationNote   String?   @map("application_note") @db.Text
  applicationImages Json?     @map("application_images")
  rating            Decimal   @default(5.00) @db.Decimal(3, 2)
  totalOrders       Int       @default(0) @map("total_orders")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  orders                Order[]
  serviceBookingOrders  ServiceBookingOrder[]       @relation("StaffServiceBookingOrders")
  assignments           OrderAssignment[]
  checkins              ServiceCheckin[]
  photos                ServicePhoto[]
  incomeRecords         StaffIncomeRecord[]
  withdrawRequests      WithdrawRequest[]
  reviews               Review[]
  profileChangeRequests StaffProfileChangeRequest[]
  user                  User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([status])
  @@index([workStatus])
  @@index([cityCode])
  @@map("staff")
}

model AdminUser {
  id           BigInt    @id @default(autoincrement())
  uuid         String    @unique @default(uuid()) @db.VarChar(36)
  username     String    @unique @db.VarChar(64)
  passwordHash String    @map("password_hash") @db.VarChar(128)
  name         String    @db.VarChar(64)
  phone        String?   @db.VarChar(20)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(512)
  role         String    @db.VarChar(32)
  roleId       BigInt?   @map("role_id")
  version      Int       @default(0)
  status       Int       @default(1) @db.SmallInt
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  roleRecord Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  operationRequests AdminOperationRequest[]

  @@index([roleId])
  @@map("admin_users")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(64)
  displayName String   @map("display_name") @db.VarChar(64)
  permissions Json?
  status      String   @default("active") @db.VarChar(16)
  isSystem    Boolean  @default(false) @map("is_system")
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  adminUsers AdminUser[]

  @@map("roles")
}

model AdminOperationRequest {
  id             BigInt    @id @default(autoincrement())
  adminId        BigInt    @map("admin_id")
  operation      String    @db.VarChar(64)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(96)
  requestHash    String    @map("request_hash") @db.Char(64)
  status         String    @default("processing") @db.VarChar(16)
  targetType     String?   @map("target_type") @db.VarChar(48)
  targetId       String?   @map("target_id") @db.VarChar(64)
  result         Json?
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@unique([adminId, operation, idempotencyKey])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("admin_operation_requests")
}

model LoginLog {
  id          BigInt   @id @default(autoincrement())
  userType    String   @map("user_type") @db.VarChar(16)
  userId      BigInt   @map("user_id")
  loginMethod String   @map("login_method") @db.VarChar(32)
  ip          String?  @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userType, userId])
  @@map("login_logs")
}

// ==================== 2. Service Management ====================

model ServiceCategory {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(64)
  icon        String?  @db.VarChar(256)
  description String?  @db.VarChar(512)
  sortOrder   Int      @default(0) @map("sort_order")
  status      Int      @default(1) @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services Service[]

  @@map("service_categories")
}

model Service {
  id                   BigInt    @id @default(autoincrement())
  uuid                 String    @unique @default(uuid()) @db.VarChar(36)
  code                 String    @unique @db.VarChar(64)
  categoryId           BigInt    @map("category_id")
  name                 String    @db.VarChar(128)
  description          String?   @db.Text
  detail               String?   @db.Text
  coverImage           String?   @map("cover_image") @db.VarChar(512)
  basePrice            Decimal   @map("base_price") @db.Decimal(10, 2)
  priceUnit            String    @map("price_unit") @db.VarChar(16)
  minPrice             Decimal?  @map("min_price") @db.Decimal(10, 2)
  durationMinutes      Int?      @map("duration_minutes")
  cardType             String    @default("none") @map("card_type") @db.VarChar(32)
  consumeUnit          Int?      @map("consume_unit")
  consultationRequired Boolean   @default(false) @map("consultation_required")
  serviceArea          String?   @map("service_area") @db.VarChar(256)
  notice               String?   @db.Text
  status               Int       @default(1) @db.SmallInt
  sortOrder            Int       @default(0) @map("sort_order")
  cityCode             String?   @map("city_code") @db.VarChar(20)
  totalOrders          Int       @default(0) @map("total_orders")
  rating               Decimal   @default(5.00) @db.Decimal(3, 2)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  category             ServiceCategory         @relation(fields: [categoryId], references: [id])
  priceRules           ServicePriceRule[]
  images               ServiceImage[]
  orders               Order[]
  serviceBookingOrders ServiceBookingOrder[]   @relation("ServiceBookingService")
  reviews              Review[]
  favorites            ServiceFavorite[]
  memberCardRules      MemberCardServiceRule[]

  @@index([categoryId])
  @@index([status])
  @@index([cityCode])
  @@map("services")
}

model ServicePriceRule {
  id         BigInt   @id @default(autoincrement())
  serviceId  BigInt   @map("service_id")
  ruleType   String   @map("rule_type") @db.VarChar(32)
  ruleName   String   @map("rule_name") @db.VarChar(64)
  ruleConfig Json     @map("rule_config")
  status     Int      @default(1) @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@map("service_price_rules")
}

model ServiceImage {
  id        BigInt   @id @default(autoincrement())
  serviceId BigInt   @map("service_id")
  url       String   @db.VarChar(512)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@map("service_images")
}

model HomeBanner {
  id        BigInt   @id @default(autoincrement())
  title     String   @db.VarChar(64)
  subtitle  String?  @db.VarChar(128)
  imageUrl  String   @map("image_url") @db.VarChar(512)
  linkType  String   @default("none") @map("link_type") @db.VarChar(32)
  linkValue String?  @map("link_value") @db.VarChar(128)
  sortOrder Int      @default(0) @map("sort_order")
  status    Int      @default(1) @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("home_banners")
}

model PromotionLink {
  id          BigInt    @id @default(autoincrement())
  linkKey     String    @unique @map("link_key") @db.VarChar(64)
  title       String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  targetType  String    @map("target_type") @db.VarChar(32)
  targetId    BigInt?   @map("target_id")
  targetCode  String?   @map("target_code") @db.VarChar(100)
  source      String    @default("channels") @db.VarChar(32)
  campaignId  BigInt?   @map("campaign_id")
  sortOrder   Int       @default(0) @map("sort_order")
  status      Int       @default(1) @db.SmallInt
  startAt     DateTime? @map("start_at")
  endAt       DateTime? @map("end_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@index([targetType])
  @@map("promotion_links")
}

// ==================== 3. Unified Address ====================

model Address {
  id               BigInt    @id @default(autoincrement())
  uuid             String    @unique @default(uuid()) @db.VarChar(36)
  ownerType        String    @map("owner_type") @db.VarChar(16)
  ownerId          BigInt    @map("owner_id")
  addressType      String    @default("service") @map("address_type") @db.VarChar(32)
  contactName      String    @map("contact_name") @db.VarChar(64)
  contactPhone     String    @map("contact_phone") @db.VarChar(20)
  country          String?   @db.VarChar(32)
  province         String?   @db.VarChar(32)
  city             String?   @db.VarChar(32)
  district         String?   @db.VarChar(32)
  street           String?   @db.VarChar(64)
  addressTitle     String?   @map("address_title") @db.VarChar(128)
  detailAddress    String    @map("detail_address") @db.VarChar(256)
  houseNumber      String?   @map("house_number") @db.VarChar(64)
  formattedAddress String    @map("formatted_address") @db.VarChar(512)
  latitude         Decimal?  @db.Decimal(10, 7)
  longitude        Decimal?  @db.Decimal(10, 7)
  coordinateType   String?   @map("coordinate_type") @db.VarChar(16)
  poiId            String?   @map("poi_id") @db.VarChar(128)
  mapProvider      String?   @map("map_provider") @db.VarChar(16)
  isDefault        Boolean   @default(false) @map("is_default")
  source           String    @default("manual") @db.VarChar(16)
  status           Int       @default(1) @db.SmallInt
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  revisions             AddressRevision[]
  sourcedOrderAddresses OrderAddress[]    @relation("OrderAddressSource")

  @@index([ownerType, ownerId])
  @@index([ownerType, ownerId, addressType])
  @@index([city, district])
  @@index([latitude, longitude])
  @@map("addresses")
}

model AddressRevision {
  id           BigInt   @id @default(autoincrement())
  addressId    BigInt   @map("address_id")
  version      Int
  snapshot     Json
  changeType   String   @map("change_type") @db.VarChar(32)
  operatorType String   @map("operator_type") @db.VarChar(16)
  operatorId   BigInt?  @map("operator_id")
  reason       String?  @db.VarChar(256)
  createdAt    DateTime @default(now()) @map("created_at")

  address Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@unique([addressId, version])
  @@index([operatorType, operatorId])
  @@map("address_revisions")
}

model OrderAddress {
  id                   BigInt   @id @default(autoincrement())
  orderId              BigInt   @unique @map("order_id")
  sourceAddressId      BigInt?  @map("source_address_id")
  sourceAddressVersion Int?     @map("source_address_version")
  contactName          String   @map("contact_name") @db.VarChar(64)
  contactPhone         String   @map("contact_phone") @db.VarChar(20)
  country              String?  @db.VarChar(32)
  province             String?  @db.VarChar(32)
  city                 String?  @db.VarChar(32)
  district             String?  @db.VarChar(32)
  street               String?  @db.VarChar(64)
  addressTitle         String?  @map("address_title") @db.VarChar(128)
  detailAddress        String   @map("detail_address") @db.VarChar(256)
  houseNumber          String?  @map("house_number") @db.VarChar(64)
  formattedAddress     String   @map("formatted_address") @db.VarChar(512)
  latitude             Decimal? @db.Decimal(10, 7)
  longitude            Decimal? @db.Decimal(10, 7)
  coordinateType       String?  @map("coordinate_type") @db.VarChar(16)
  poiId                String?  @map("poi_id") @db.VarChar(128)
  mapProvider          String?  @map("map_provider") @db.VarChar(16)
  source               String   @default("manual") @db.VarChar(16)
  version              Int      @default(1)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceAddress Address?               @relation("OrderAddressSource", fields: [sourceAddressId], references: [id], onDelete: SetNull)
  revisions     OrderAddressRevision[]

  @@index([sourceAddressId])
  @@index([city, district])
  @@index([latitude, longitude])
  @@map("order_addresses")
}

model OrderAddressRevision {
  id             BigInt   @id @default(autoincrement())
  orderAddressId BigInt   @map("order_address_id")
  version        Int
  snapshot       Json
  changeType     String   @map("change_type") @db.VarChar(32)
  operatorType   String   @map("operator_type") @db.VarChar(16)
  operatorId     BigInt?  @map("operator_id")
  reason         String?  @db.VarChar(256)
  requestId      String?  @map("request_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")

  orderAddress OrderAddress @relation(fields: [orderAddressId], references: [id], onDelete: Cascade)

  @@unique([orderAddressId, version])
  @@index([operatorType, operatorId])
  @@map("order_address_revisions")
}

// ==================== 4. Orders ====================

model Order {
  id                      BigInt    @id @default(autoincrement())
  orderNo                 String    @unique @map("order_no") @db.VarChar(32)
  userId                  BigInt    @map("user_id")
  staffId                 BigInt?   @map("staff_id")
  serviceId               BigInt    @map("service_id")
  orderType               String    @default("service_booking") @map("order_type") @db.VarChar(32)
  status                  String    @db.VarChar(32)
  version                 Int       @default(0)
  serviceSnapshot         Json      @map("service_snapshot")
  appointmentStartTime    DateTime  @map("appointment_start_time")
  appointmentEndTime      DateTime  @map("appointment_end_time")
  originalAmount          Decimal   @map("original_amount") @db.Decimal(10, 2)
  discountAmount          Decimal   @default(0) @map("discount_amount") @db.Decimal(10, 2)
  payableAmount           Decimal   @map("payable_amount") @db.Decimal(10, 2)
  paidAmount              Decimal   @default(0) @map("paid_amount") @db.Decimal(10, 2)
  couponId                BigInt?   @map("coupon_id")
  memberCardId            BigInt?   @map("member_card_id")
  memberCardConsumeUnits  Int       @default(0) @map("member_card_consume_units")
  memberCardRuleSnapshot  Json?     @map("member_card_rule_snapshot")
  purchaseCardId          BigInt?   @map("purchase_card_id")
  grantedUserMemberCardId BigInt?   @map("granted_user_member_card_id")
  linkedPurchaseOrderId   BigInt?   @map("linked_purchase_order_id")
  linkedBookingOrderId    BigInt?   @map("linked_booking_order_id")
  remark                  String?   @db.VarChar(512)
  adminRemark             String?   @map("admin_remark") @db.VarChar(512)
  source                  String    @default("miniapp") @db.VarChar(16)
  cityCode                String?   @map("city_code") @db.VarChar(20)
  storeId                 BigInt?   @map("store_id")
  paidAt                  DateTime? @map("paid_at")
  completedAt             DateTime? @map("completed_at")
  cancelledAt             DateTime? @map("cancelled_at")
  cancelReason            String?   @map("cancel_reason") @db.VarChar(256)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user               User                     @relation(fields: [userId], references: [id])
  staff              Staff?                   @relation(fields: [staffId], references: [id])
  service            Service                  @relation(fields: [serviceId], references: [id])
  orderAddress       OrderAddress?
  statusLogs         OrderStatusLog[]
  assignments        OrderAssignment[]
  payments           Payment[]
  refunds            Refund[]
  checkins           ServiceCheckin[]
  photos             ServicePhoto[]
  review             Review?
  tickets            Ticket[]
  incomeRecords      StaffIncomeRecord[]
  memberCardRecords  MemberCardRecord[]
  serviceBooking     ServiceBookingOrder?     @relation("OrderServiceBooking")
  memberCardPurchase MemberCardPurchaseOrder? @relation("OrderMemberCardPurchase")
  purchasedUserCard  UserMemberCard?          @relation("UserCardPurchaseOrder")
  pointLedgers       PointLedger[]
  pointRewardEvents  PointRewardEvent[]

  @@index([userId])
  @@index([staffId])
  @@index([status])
  @@index([orderType])
  @@index([orderType, status])
  @@index([userId, status])
  @@index([staffId, status])
  @@index([purchaseCardId])
  @@index([grantedUserMemberCardId])
  @@index([linkedPurchaseOrderId])
  @@index([linkedBookingOrderId])
  @@index([status, appointmentStartTime])
  @@index([createdAt])
  @@map("orders")
}

// Day49 keeps transaction facts in orders and moves task-only and card-purchase-only
// data into explicit one-to-one extensions.
model ServiceBookingOrder {
  orderId            BigInt    @id @map("order_id")
  serviceId          BigInt    @map("service_id")
  serviceSnapshot    Json      @map("service_snapshot")
  staffId            BigInt?   @map("staff_id")
  appointmentStartAt DateTime  @map("appointment_start_at")
  appointmentEndAt   DateTime  @map("appointment_end_at")
  fulfilledAt        DateTime? @map("fulfilled_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  order      Order            @relation("OrderServiceBooking", fields: [orderId], references: [id], onDelete: Cascade)
  service    Service          @relation("ServiceBookingService", fields: [serviceId], references: [id])
  staff      Staff?           @relation("StaffServiceBookingOrders", fields: [staffId], references: [id])
  redemption OrderRedemption? @relation("BookingOrderRedemption")

  @@index([staffId, appointmentStartAt])
  @@index([serviceId, appointmentStartAt])
  @@map("service_booking_orders")
}

model MemberCardPurchaseOrder {
  orderId                 BigInt    @id @map("order_id")
  memberCardPlanId        BigInt    @map("member_card_plan_id")
  memberCardPlanVersion   Int       @map("member_card_plan_version")
  planSnapshot            Json      @map("plan_snapshot")
  grantedUserMemberCardId BigInt?   @unique @map("granted_user_member_card_id")
  grantedAt               DateTime? @map("granted_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  order           Order           @relation("OrderMemberCardPurchase", fields: [orderId], references: [id], onDelete: Cascade)
  plan            MemberCard      @relation(fields: [memberCardPlanId], references: [id])
  grantedUserCard UserMemberCard? @relation("MemberCardPurchaseGrant", fields: [grantedUserMemberCardId], references: [id])

  @@index([memberCardPlanId, memberCardPlanVersion])
  @@map("member_card_purchase_orders")
}

model OrderStatusLog {
  id           BigInt   @id @default(autoincrement())
  orderId      BigInt   @map("order_id")
  fromStatus   String?  @map("from_status") @db.VarChar(32)
  toStatus     String   @map("to_status") @db.VarChar(32)
  operatorType String   @map("operator_type") @db.VarChar(16)
  operatorId   BigInt   @map("operator_id")
  action       String?  @db.VarChar(64)
  requestId    String?  @map("request_id") @db.VarChar(64)
  detail       Json?
  remark       String?  @db.VarChar(256)
  createdAt    DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([orderId, createdAt])
  @@index([requestId])
  @@index([action])
  @@map("order_status_logs")
}

model OrderAssignment {
  id                 BigInt    @id @default(autoincrement())
  orderId            BigInt    @map("order_id")
  staffId            BigInt    @map("staff_id")
  assignType         String    @map("assign_type") @db.VarChar(16)
  assignStatus       String    @map("assign_status") @db.VarChar(16)
  assignedBy         BigInt    @map("assigned_by")
  notificationId     BigInt?   @map("notification_id")
  notificationStatus String?   @map("notification_status") @db.VarChar(16)
  rejectReason       String?   @map("reject_reason") @db.VarChar(256)
  assignedAt         DateTime  @default(now()) @map("assigned_at")
  acceptedAt         DateTime? @map("accepted_at")
