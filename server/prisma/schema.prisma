  trigger        String   @db.VarChar(32)
  status         String   @default("active") @db.VarChar(16)
  currentVersion Int      @default(0) @map("current_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  versions PointRewardRuleVersion[]

  @@map("point_reward_rules")
}

model PointRewardRuleVersion {
  id                       BigInt   @id @default(autoincrement())
  ruleId                   BigInt   @map("rule_id")
  version                  Int
  calculationType          String   @map("calculation_type") @db.VarChar(48)
  qualificationConfig      Json?    @map("qualification_config")
  calculationConfig        Json?    @map("calculation_config")
  earnPointsPerYuan        Int      @default(10) @map("earn_points_per_yuan")
  redemptionPointsPerYuan  Int      @default(200) @map("redemption_points_per_yuan")
  effectiveAt              DateTime @default(now()) @map("effective_at")
  publishedBy              BigInt?  @map("published_by")
  snapshot                 Json?
  createdAt                DateTime @default(now()) @map("created_at")

  rule     PointRewardRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  events   PointRewardEvent[]
  ledgers  PointLedger[]

  @@unique([ruleId, version])
  @@index([ruleId, effectiveAt])
  @@map("point_reward_rule_versions")
}

model PointRewardEvent {
  id                  BigInt   @id @default(autoincrement())
  eventKey            String   @unique @map("event_key") @db.VarChar(160)
  orderId             BigInt   @map("order_id")
  ruleVersionId       BigInt   @map("rule_version_id")
  beneficiaryUserId   BigInt   @map("beneficiary_user_id")
  sourceUserId        BigInt?  @map("source_user_id")
  referralBindingId   BigInt?  @map("referral_binding_id")
  status              String   @default("granted") @db.VarChar(24)
  baseAmount          Decimal  @default(0) @map("base_amount") @db.Decimal(10, 2)
  rewardValue         Decimal  @default(0) @map("reward_value") @db.Decimal(10, 2)
  points              Int
  reversedPoints      Int      @default(0) @map("reversed_points")
  reversedBaseAmount  Decimal  @default(0) @map("reversed_base_amount") @db.Decimal(10, 2)
  reversedAt          DateTime? @map("reversed_at")
  calculationSnapshot Json?    @map("calculation_snapshot")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  order           Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ruleVersion     PointRewardRuleVersion  @relation(fields: [ruleVersionId], references: [id])
  beneficiaryUser User                    @relation("PointRewardBeneficiary", fields: [beneficiaryUserId], references: [id])
  sourceUser      User?                   @relation("PointRewardSource", fields: [sourceUserId], references: [id], onDelete: SetNull)
  referralBinding ReferralBinding?        @relation(fields: [referralBindingId], references: [id], onDelete: SetNull)
  ledgers         PointLedger[]
  reversals       PointRewardReversal[]

  @@index([orderId, createdAt])
  @@index([beneficiaryUserId, createdAt])
  @@index([sourceUserId, createdAt])
  @@index([referralBindingId])
  @@map("point_reward_events")
}

model PointRewardReversal {
  id             BigInt   @id @default(autoincrement())
  rewardEventId  BigInt   @map("reward_event_id")
  refundId       BigInt   @map("refund_id")
  refundAmount   Decimal  @map("refund_amount") @db.Decimal(10, 2)
  reversedPoints Int      @map("reversed_points")
  eventKey       String   @unique @map("event_key") @db.VarChar(160)
  createdAt      DateTime @default(now()) @map("created_at")

  rewardEvent PointRewardEvent @relation(fields: [rewardEventId], references: [id], onDelete: Cascade)
  refund      Refund           @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@unique([rewardEventId, refundId])
  @@index([refundId])
  @@map("point_reward_reversals")
}

model ReferralInviteCode {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  code      String   @unique @db.VarChar(24)
  status    String   @default("active") @db.VarChar(16)
  rotatedAt DateTime? @map("rotated_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  invites ReferralInvite[]
  bindings ReferralBinding[]

  @@map("referral_invite_codes")
}

model ReferralInvite {
  id           BigInt   @id @default(autoincrement())
  token        String   @unique @db.VarChar(96)
  inviterUserId BigInt  @map("inviter_user_id")
  inviteCodeId BigInt?  @map("invite_code_id")
  channel      String   @default("link") @db.VarChar(16)
  status       String   @default("active") @db.VarChar(16)
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  inviter   User                @relation("ReferralInviteInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  inviteCode ReferralInviteCode? @relation(fields: [inviteCodeId], references: [id], onDelete: SetNull)
  bindings  ReferralBinding[]

  @@index([inviterUserId, status])
  @@index([expiresAt])
  @@map("referral_invites")
}

model ReferralBinding {
  id            BigInt   @id @default(autoincrement())
  inviterUserId BigInt   @map("inviter_user_id")
  inviteeUserId BigInt   @unique @map("invitee_user_id")
  inviteId      BigInt?  @map("invite_id")
  inviteCodeId  BigInt?  @map("invite_code_id")
  source        String   @db.VarChar(16)
  status        String   @default("active") @db.VarChar(16)
  riskLevel     String?  @map("risk_level") @db.VarChar(16)
  riskReason    String?  @map("risk_reason") @db.VarChar(256)
  reviewedBy    BigInt?  @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  boundAt       DateTime @default(now()) @map("bound_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  inviter   User               @relation("ReferralBindingInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitee   User               @relation("ReferralBindingInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)
  invite    ReferralInvite?    @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  inviteCode ReferralInviteCode? @relation(fields: [inviteCodeId], references: [id], onDelete: SetNull)
  events    PointRewardEvent[]
  ledgers   PointLedger[]

  @@index([inviterUserId, status])
  @@index([status, boundAt])
  @@map("referral_bindings")
}

// ==================== 11. File ====================

model File {
  id           BigInt    @id @default(autoincrement())
  uuid         String    @unique @default(uuid()) @db.VarChar(36)
  uploaderType String    @map("uploader_type") @db.VarChar(16)
  uploaderId   BigInt    @map("uploader_id")
  bizType      String    @map("biz_type") @db.VarChar(32)
  bizId        BigInt?   @map("biz_id")
  filename     String    @db.VarChar(256)
  url          String    @db.VarChar(512)
  storageKey   String    @map("storage_key") @db.VarChar(512)
  mimeType     String    @map("mime_type") @db.VarChar(64)
  size         BigInt
  status       String    @default("active") @db.VarChar(16)
  source       String?   @db.VarChar(32)
  visibility   String    @default("private") @db.VarChar(16)
  alt          String?   @db.VarChar(128)
  remark       String?   @db.VarChar(512)
  deletedBy    BigInt?   @map("deleted_by")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([bizType, bizId])
  @@index([status, createdAt])
  @@index([uploaderType, uploaderId])
  @@index([url])
  @@map("files")
}

// ==================== 12. Finance ====================

model StaffIncomeRecord {
  id                BigInt    @id @default(autoincrement())
  staffId           BigInt    @map("staff_id")
  orderId           BigInt    @map("order_id")
  withdrawRequestId BigInt?   @map("withdraw_request_id")
  amount            Decimal   @db.Decimal(10, 2)
  type              String    @db.VarChar(32)
  status            String    @db.VarChar(32)
  settlementStatus  String    @default("pending") @map("settlement_status") @db.VarChar(32)
  withdrawStatus    String    @default("none") @map("withdraw_status") @db.VarChar(32)
  availableAt       DateTime? @map("available_at")
  settledAt         DateTime? @map("settled_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  staff           Staff            @relation(fields: [staffId], references: [id])
  order           Order            @relation(fields: [orderId], references: [id])
  withdrawRequest WithdrawRequest? @relation(fields: [withdrawRequestId], references: [id])

  @@unique([staffId, orderId, type])
  @@index([staffId])
  @@index([withdrawRequestId])
  @@index([settlementStatus, withdrawStatus])
  @@index([availableAt])
  @@map("staff_income_records")
}

model WithdrawRequest {
  id                BigInt    @id @default(autoincrement())
  withdrawNo        String    @unique @map("withdraw_no") @db.VarChar(64)
  staffId           BigInt    @map("staff_id")
  amount            Decimal   @db.Decimal(10, 2)
  amountFen         Int       @default(0) @map("amount_fen")
  feeAmount         Decimal   @default(0) @map("fee_amount") @db.Decimal(10, 2)
  availableSnapshot Decimal   @default(0) @map("available_snapshot") @db.Decimal(10, 2)
  status            String    @db.VarChar(32)
  channel           String    @default("mock") @db.VarChar(16)
  outBillNo         String?   @unique @map("out_bill_no") @db.VarChar(64)
  transferBillNo    String?   @map("transfer_bill_no") @db.VarChar(128)
  packageInfo       String?   @map("package_info") @db.Text
  openid            String?   @db.VarChar(64)
  userNameEncrypted String?   @map("user_name_encrypted") @db.VarChar(512)
  bankInfo          Json      @map("bank_info")
  failureReason     String?   @map("failure_reason") @db.VarChar(512)
  rejectReason      String?   @map("reject_reason") @db.VarChar(512)
  notifyRaw         String?   @map("notify_raw") @db.Text
  retryCount        Int       @default(0) @map("retry_count")
  version           Int       @default(0)
  requestId         String?   @map("request_id") @db.VarChar(64)
  handledBy         BigInt?   @map("handled_by")
  handledAt         DateTime? @map("handled_at")
  reviewedBy        BigInt?   @map("reviewed_by")
  reviewedAt        DateTime? @map("reviewed_at")
  processedAt       DateTime? @map("processed_at")
  paidAt            DateTime? @map("paid_at")
  expiredAt         DateTime? @map("expired_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  staff         Staff               @relation(fields: [staffId], references: [id])
  incomeRecords StaffIncomeRecord[]
  statusLogs    WithdrawStatusLog[]

  @@index([staffId])
  @@index([status])
  @@index([channel])
  @@index([transferBillNo])
  @@index([createdAt])
  @@map("withdraw_requests")
}

model WithdrawStatusLog {
  id                BigInt   @id @default(autoincrement())
  withdrawRequestId BigInt   @map("withdraw_request_id")
  fromStatus        String?  @map("from_status") @db.VarChar(32)
  toStatus          String   @map("to_status") @db.VarChar(32)
  action            String   @db.VarChar(64)
  operatorType      String   @map("operator_type") @db.VarChar(16)
  operatorId        BigInt   @map("operator_id")
  remark            String?  @db.VarChar(512)
  detail            Json?
  requestId         String?  @map("request_id") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at")

  withdrawRequest WithdrawRequest @relation(fields: [withdrawRequestId], references: [id])

  @@index([withdrawRequestId])
  @@index([action])
  @@index([createdAt])
  @@map("withdraw_status_logs")
}

// ==================== 13. Audit Log ====================

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  operatorType String   @map("operator_type") @db.VarChar(16)
  operatorId   BigInt   @map("operator_id")
  action       String   @db.VarChar(64)
  module       String   @db.VarChar(32)
  targetType   String?  @map("target_type") @db.VarChar(32)
  targetId     BigInt?  @map("target_id")
  detail       Json?
  ip           String?  @db.VarChar(64)
  requestId    String?  @map("request_id") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([operatorType, operatorId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== 14. Appointment Time Lock ====================

model AppointmentTimeLock {
  id        BigInt   @id @default(autoincrement())
  lockDate  DateTime @map("lock_date") @db.Date
  timeSlot  String   @map("time_slot") @db.VarChar(16)
  reason    String?  @db.VarChar(256)
  status    String   @default("active") @db.VarChar(16)
  createdBy BigInt   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([lockDate, timeSlot])
  @@index([lockDate, status])
  @@index([createdBy])
  @@map("appointment_time_locks")
}

// ==================== 15. Favorite ====================

model ServiceFavorite {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  serviceId BigInt   @map("service_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([userId, serviceId])
  @@map("service_favorites")
}
